YOUTRACK_URL=
YOUTRACK_TOKEN=
YOUTRACK_PROJECT_ID=
GEMINI_API_KEY=
NUXT_SECRET=
# Secreto para sellar la cookie de sesión (≥32 caracteres). FIJO: si cambia,
# desloguea a todos. Generar con: openssl rand -base64 36
NUXT_SESSION_PASSWORD=
# Seed sintético en arranque (solo staging B). Ausente/false en producción.
AUTO_SEED=
# Puerto del host para el servicio prod (opcional; default 3000 si no se define).
# docker compose lee este .env solo para resolver ${P:-3000} en docker-compose.yml.
P=
